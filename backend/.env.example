# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=nexus-dev-secret-change-me

# ── Database (SQLite for dev; swap to postgresql://... for prod) ───────────
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# ── Monitoring ────────────────────────────────────────────────────────────────
METRICS_INTERVAL_SECONDS=2.0
METRICS_HISTORY_MINUTES=60

# ── ML ────────────────────────────────────────────────────────────────────────
ANOMALY_CONTAMINATION=0.05
FORECAST_HORIZON_MINUTES=10

# ── Decision / Action ─────────────────────────────────────────────────────────
SIMULATION_MODE=true
CPU_WARNING_PCT=85.0
CPU_CRITICAL_PCT=95.0
RAM_WARNING_PCT=80.0
RAM_CRITICAL_PCT=92.0
DISK_WARNING_PCT=85.0
DISK_CRITICAL_PCT=95.0

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nexus2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI / Gemini LLM Integration ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

